# API server (apps/api) — copy to .env for local overrides
PORT=4000
NODE_ENV=development

# REQUIRED in production — generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-random-bytes
JWT_EXPIRES_IN=7d

# Comma-separated allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# SQLite location (defaults to <repo>/data/killchain.db)
# DB_PATH=./data/killchain.db

# Web dev server proxy target (apps/web Vite)
VITE_API_PROXY=http://localhost:4000
